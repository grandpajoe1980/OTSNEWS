{
  "name": "ots-news",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run db:seed && concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node --env-file=.env --import tsx server/index.ts",
    "dev": "npm run db:seed && concurrently \"npm run server\" \"npm run client\"",
    "db:seed": "node --env-file=.env --import tsx server/seed.ts",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@node-saml/node-saml": "^5.1.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "fast-xml-parser": "^5.3.6",
    "helmet": "^8.1.0",
    "lucide-react": "^0.563.0",
    "nodemailer": "^8.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanitize-html": "^2.17.0",
    "sql.js": "^1.13.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^7.0.9",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "6.2.0"
  }
}
